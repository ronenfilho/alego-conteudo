rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função para verificar se o usuário é o dono do documento
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Regras para a coleção de estudos
    match /processos/{processoId} {
      // Permitir leitura apenas para o dono
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Permitir criação apenas para usuários autenticados
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['name', 'content', 'userId', 'createdAt', 'updatedAt']);
      
      // Permitir atualização apenas para o dono
      allow update: if isAuthenticated() 
                    && isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      
      // Permitir exclusão apenas para o dono
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Regras para a coleção de progresso de estudos
    match /progress/{progressId} {
      // Permitir leitura apenas para o dono (progressId format: userId_processoId)
      allow read: if isAuthenticated() && progressId.matches('^' + request.auth.uid + '_.*');
      
      // Permitir criação e atualização apenas para o dono
      allow write: if isAuthenticated() 
                    && progressId.matches('^' + request.auth.uid + '_.*')
                    && request.resource.data.userId == request.auth.uid;
      
      // Permitir exclusão apenas para o dono
      allow delete: if isAuthenticated() && progressId.matches('^' + request.auth.uid + '_.*');
    }
    
    // Regras para a coleção de configurações de embed
    match /embedConfigs/{disciplina} {
      // Permitir leitura para todos os usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir escrita apenas para admins (você pode adicionar lógica de admin)
      // Por enquanto, apenas usuários específicos ou adicionar campo isAdmin
      allow write: if false; // Desabilitado - gerenciar via console do Firebase ou Cloud Functions
    }
    
    // Regras para logs de analytics de embed
    match /embedAnalytics/{analyticsId} {
      // Permitir apenas criação (append-only) para usuários autenticados
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Não permitir leitura, update ou delete por usuários comuns
      allow read, update, delete: if false;
    }
    
    // Regra padrão: negar acesso a qualquer outra coleção não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
